{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.shortmaker/schema/shortmaker-1.1.json",
  "title": "SHORTMAKER Edit Plan",
  "type": "object",
  "required": [
    "schema_version",
    "shorts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "project": {
      "type": "object",
      "additionalProperties": true
    },
    "defaults": {
      "type": "object",
      "additionalProperties": true
    },
    "shorts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/short"
      }
    },
    "publishing": {
      "type": "object",
      "additionalProperties": true
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "timecode": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^(?:\\d{2}:)?[0-5]?\\d:[0-5]\\d(?:\\.\\d{1,3})?$"
        }
      ]
    },
    "voiceover": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "voice": {
          "type": [
            "string",
            "null"
          ]
        },
        "voice_id": {
          "type": "string",
          "pattern": "^[a-z]{2}_[A-Z]{2}-[a-zA-Z0-9_]+-(?:low|medium|high|x_low)$",
          "description": "M3.1: identificador do modelo Piper local, por exemplo pt_BR-faber-medium"
        },
        "pronunciation_overrides": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "M3.2: substituições somente no texto enviado ao TTS; legendas e editorial preservados"
        },
        "rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0
        },
        "start_offset": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "segment": {
      "type": "object",
      "required": [
        "type",
        "start",
        "end"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "source_clip"
          ]
        },
        "start": {
          "$ref": "#/$defs/timecode"
        },
        "end": {
          "$ref": "#/$defs/timecode"
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reframe": {
          "type": "object",
          "additionalProperties": true
        },
        "source_audio": {
          "type": "object",
          "additionalProperties": true
        },
        "voiceover": {
          "$ref": "#/$defs/voiceover"
        },
        "overlay_text": {
          "type": [
            "object",
            "string",
            "null"
          ]
        },
        "transition_out": {
          "type": "object",
          "additionalProperties": true
        },
        "captions": {
          "$ref": "#/$defs/captions"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "trim_policy": {
          "$ref": "#/$defs/trim_policy"
        }
      },
      "additionalProperties": true
    },
    "short": {
      "type": "object",
      "required": [
        "id",
        "timeline"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "editorial": {
          "type": "object",
          "additionalProperties": true
        },
        "timeline": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "video": {
          "type": "object",
          "additionalProperties": true
        },
        "audio": {
          "type": "object",
          "additionalProperties": true
        },
        "voice": {
          "type": "object",
          "additionalProperties": true
        },
        "captions": {
          "$ref": "#/$defs/captions"
        },
        "hook": {
          "type": "object",
          "additionalProperties": true
        },
        "source_label": {
          "type": "object",
          "additionalProperties": true
        },
        "publishing": {
          "type": "object",
          "additionalProperties": true
        },
        "branding": {
          "$ref": "#/$defs/branding"
        },
        "editing": {
          "$ref": "#/$defs/editing"
        }
      },
      "additionalProperties": true
    },
    "captions": {
      "type": "object",
      "properties": {
        "style_preset": {
          "enum": [
            "default",
            "premium"
          ]
        },
        "highlight_keywords": {
          "type": "boolean"
        },
        "highlight_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "keywords": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "branding": {
      "type": "object",
      "properties": {
        "end_tag": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "secondary_text": {
              "type": "string",
              "maxLength": 40
            },
            "icon": {
              "enum": [
                "thumbs_up",
                "none"
              ]
            },
            "duration": {
              "type": "number",
              "minimum": 0.8,
              "maximum": 1.2
            },
            "position": {
              "enum": [
                "bottom_center"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "effect": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "enum": [
            "punch_in",
            "slow_zoom",
            "freeze_frame",
            "text_card",
            "speed_change",
            "fade",
            "hard_cut_marker"
          ],
          "title": "Type",
          "type": "string"
        },
        "at": {
          "default": 0,
          "minimum": 0,
          "title": "At",
          "type": "number"
        },
        "duration": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration"
        },
        "scale": {
          "default": 1.08,
          "maximum": 1.25,
          "minimum": 1,
          "title": "Scale",
          "type": "number"
        },
        "start_at": {
          "default": 0,
          "minimum": 0,
          "title": "Start At",
          "type": "number"
        },
        "end_at": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End At"
        },
        "from_scale": {
          "default": 1,
          "maximum": 1.25,
          "minimum": 1,
          "title": "From Scale",
          "type": "number"
        },
        "to_scale": {
          "default": 1.06,
          "maximum": 1.25,
          "minimum": 1,
          "title": "To Scale",
          "type": "number"
        },
        "speed": {
          "default": 1,
          "maximum": 1.35,
          "minimum": 0.75,
          "title": "Speed",
          "type": "number"
        },
        "audio_mode": {
          "default": "continue",
          "enum": [
            "continue",
            "mute",
            "duck"
          ],
          "title": "Audio Mode",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 120,
          "title": "Text",
          "type": "string"
        },
        "style": {
          "default": "editorial",
          "enum": [
            "editorial",
            "impact",
            "subtle"
          ],
          "title": "Style",
          "type": "string"
        },
        "direction": {
          "default": "in",
          "enum": [
            "in",
            "out"
          ],
          "title": "Direction",
          "type": "string"
        },
        "background": {
          "default": false,
          "title": "Background",
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "title": "Effect",
      "type": "object"
    },
    "trim_policy": {
      "additionalProperties": true,
      "properties": {
        "remove_dead_time": {
          "default": false,
          "title": "Remove Dead Time",
          "type": "boolean"
        },
        "max_removal_ms": {
          "default": 650,
          "maximum": 650,
          "minimum": 0,
          "title": "Max Removal Ms",
          "type": "integer"
        },
        "preserve_dialogue": {
          "default": true,
          "title": "Preserve Dialogue",
          "type": "boolean"
        },
        "preserve_reaction": {
          "default": true,
          "title": "Preserve Reaction",
          "type": "boolean"
        }
      },
      "title": "TrimPolicy",
      "type": "object"
    },
    "editing": {
      "additionalProperties": true,
      "properties": {
        "pace": {
          "default": "normal",
          "enum": [
            "dramatic",
            "normal",
            "fast"
          ],
          "title": "Pace",
          "type": "string"
        },
        "editorial_quality_warnings": {
          "default": false,
          "title": "Editorial Quality Warnings",
          "type": "boolean"
        }
      },
      "title": "Editing",
      "type": "object"
    }
  }
}
