{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.shortmaker/schema/shortmaker-1.1.json",
  "title": "SHORTMAKER Edit Plan",
  "type": "object",
  "required": [
    "schema_version",
    "shorts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "project": {
      "type": "object",
      "additionalProperties": true
    },
    "defaults": {
      "type": "object",
      "additionalProperties": true
    },
    "shorts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/short"
      }
    },
    "publishing": {
      "type": "object",
      "additionalProperties": true
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "timecode": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^(?:\\d{2}:)?[0-5]?\\d:[0-5]\\d(?:\\.\\d{1,3})?$"
        }
      ]
    },
    "voiceover": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "voice": {
          "type": [
            "string",
            "null"
          ]
        },
        "voice_id": {
          "type": "string",
          "pattern": "^[a-z]{2}_[A-Z]{2}-[a-zA-Z0-9_]+-(?:low|medium|high|x_low)$",
          "description": "M3.1: identificador do modelo Piper local, por exemplo pt_BR-faber-medium"
        },
        "pronunciation_overrides": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "M3.2: substituições somente no texto enviado ao TTS; legendas e editorial preservados"
        },
        "rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0
        },
        "start_offset": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "segment": {
      "type": "object",
      "required": [
        "type",
        "start",
        "end"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "source_clip"
          ]
        },
        "start": {
          "$ref": "#/$defs/timecode"
        },
        "end": {
          "$ref": "#/$defs/timecode"
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reframe": {
          "type": "object",
          "additionalProperties": true
        },
        "source_audio": {
          "type": "object",
          "additionalProperties": true
        },
        "voiceover": {
          "$ref": "#/$defs/voiceover"
        },
        "overlay_text": {
          "type": [
            "object",
            "string",
            "null"
          ]
        },
        "transition_out": {
          "type": "object",
          "additionalProperties": true
        },
        "captions": {
          "$ref": "#/$defs/captions"
        }
      },
      "additionalProperties": true
    },
    "short": {
      "type": "object",
      "required": [
        "id",
        "timeline"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "editorial": {
          "type": "object",
          "additionalProperties": true
        },
        "timeline": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "video": {
          "type": "object",
          "additionalProperties": true
        },
        "audio": {
          "type": "object",
          "additionalProperties": true
        },
        "voice": {
          "type": "object",
          "additionalProperties": true
        },
        "captions": {
          "$ref": "#/$defs/captions"
        },
        "hook": {
          "type": "object",
          "additionalProperties": true
        },
        "source_label": {
          "type": "object",
          "additionalProperties": true
        },
        "publishing": {
          "type": "object",
          "additionalProperties": true
        },
        "branding": {
          "$ref": "#/$defs/branding"
        }
      },
      "additionalProperties": true
    },
    "captions": {
      "type": "object",
      "properties": {
        "style_preset": {
          "enum": [
            "default",
            "premium"
          ]
        },
        "highlight_keywords": {
          "type": "boolean"
        },
        "highlight_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "keywords": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "branding": {
      "type": "object",
      "properties": {
        "end_tag": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "secondary_text": {
              "type": "string",
              "maxLength": 40
            },
            "icon": {
              "enum": [
                "thumbs_up",
                "none"
              ]
            },
            "duration": {
              "type": "number",
              "minimum": 0.8,
              "maximum": 1.2
            },
            "position": {
              "enum": [
                "bottom_center"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
